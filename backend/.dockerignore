# Keep the build context small and keep secrets out of the image.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Real credentials. The image reads its configuration from the environment.
.env
.env.local

# Uploaded client documents — a runtime volume, never image content.
var/

tests/
*.db
*.sqlite3
.DS_Store
