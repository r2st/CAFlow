# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Matches docker-compose.yml (host port 5434 to avoid clashing with a local server).
DATABASE_URL=postgresql+psycopg://caflow:caflow@localhost:5434/caflow

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Queue ---
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# --- AI (OpenRouter free models) ---
# Get a key at https://openrouter.ai/keys — leave blank to run on heuristics only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=google/gemma-3-27b-it:free

# --- Compliance generation ---
COMPLIANCE_GENERATION_MONTHS=12
