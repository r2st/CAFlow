# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Matches docker-compose.yml (host port 5434 to avoid clashing with a local server).
DATABASE_URL=postgresql+psycopg://caflow:caflow@localhost:5434/caflow

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# How long a client portal magic link stays usable (default 7 days).
MAGIC_LINK_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Client portal ---
# Magic links are built as PORTAL_BASE_URL?token=...
PORTAL_BASE_URL=http://localhost:5173/portal

# --- Document storage ---
# Local filesystem; point at a mounted volume in production.
STORAGE_DIR=./var/documents
MAX_UPLOAD_BYTES=20971520

# --- Billing ---
INVOICE_NUMBER_PREFIX=INV
INVOICE_PAYMENT_TERMS_DAYS=15
INVOICE_GST_RATE_BPS=1800
# Days *after* the due date on which to chase an unpaid invoice.
PAYMENT_REMINDER_OFFSETS_DAYS=0,7,15,30

# --- Document collection reminders ---
# Days *before* a filing's due date on which to chase the client for documents.
DOCUMENT_REMINDER_OFFSETS_DAYS=15,10,5,2

# --- Email delivery (SMTP) ---
# Leave SMTP_HOST blank to log mail instead of sending it — the dispatcher still
# runs end to end, which is what you want in development and CI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587; set SMTP_USE_SSL=true for implicit TLS on port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=no-reply@caflow.local
EMAIL_FROM_NAME=CAFlow
# Reminders are retried on later dispatcher runs up to this many attempts.
REMINDER_MAX_ATTEMPTS=3

# --- Queue ---
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# --- AI (OpenRouter free models) ---
# Get a key at https://openrouter.ai/keys — leave blank to run on heuristics only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=google/gemma-3-27b-it:free

# --- Compliance generation ---
COMPLIANCE_GENERATION_MONTHS=12
