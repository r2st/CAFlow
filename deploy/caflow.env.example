# Production environment for caflow.aiknol.com.
#
#   install -d -m 0700 /etc/caflow
#   install -m 0600 deploy/caflow.env.example /etc/caflow/caflow.env
#   # ...then fill in the three secrets below.
#
# Read by systemd (EnvironmentFile= in caflow.service) and interpolated into
# deploy/docker-compose.prod.yml, which is what puts these into the containers.
# Only the settings this deployment actually changes belong here — everything
# else comes from the overlay or from the defaults in backend/app/config.py.
#
# systemd parses this file itself, not with a shell: no `export`, no command
# substitution, and a value with spaces needs quoting. Keep every secret below
# URL-safe — POSTGRES_PASSWORD is interpolated into a connection URL, where a
# `@`, `/` or `:` would be read as structure rather than as the password.
#
# Mode 0600, owned by root. These four lines are the whole security of the
# deployment: the signing key mints sessions, and the SMTP password sends mail
# as the firm.

# --- Required. Compose refuses to start the stack without them. ---

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(24))"
# Changing this after the first `up` does not change the password Postgres
# already initialised — ALTER the role, or the API cannot connect.
POSTGRES_PASSWORD=

# --- Optional: the overlay's defaults already name this host. ---

# CORS_ORIGINS=https://caflow.aiknol.com
# PORTAL_BASE_URL=https://caflow.aiknol.com/portal
# LOG_LEVEL=INFO

# --- Email. With no SMTP_HOST, reminders are written to the log instead of
# --- sent, which is a fine way to bring the stack up and a bad way to leave it:
# --- every payment and document reminder the firm relies on goes nowhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@aiknol.com
EMAIL_FROM_NAME=CAFlow

# --- AI document categorisation. Without a key, uploads are categorised from
# --- the filename alone, which works and is visibly worse.
OPENROUTER_API_KEY=

# --- Backups (deploy/caflow-backup.sh). ---
BACKUP_DIR=/var/backups/caflow
BACKUP_KEEP_DAYS=14
COMPOSE_DIR=/srv/caflow
