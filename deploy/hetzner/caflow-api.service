[Unit]
Description=CAFlow API (FastAPI/uvicorn)
Documentation=https://github.com/r2st/CAFlow
# Bound to the Docker bridge gateway so Caddy (in a container) can reach it
# while the public internet cannot — hence the docker ordering.
After=network.target postgresql.service redis-server.service docker.service
Wants=postgresql.service redis-server.service docker.service

[Service]
Type=simple
User=caflow
Group=caflow
WorkingDirectory=/opt/CAFlow/backend
EnvironmentFile=/opt/CAFlow/.env
ExecStart=/opt/CAFlow/.venv/bin/uvicorn app.main:app --host 172.18.0.1 --port 3010 --workers 2
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Uploaded documents land under /opt/CAFlow/var/documents (STORAGE_DIR).
ReadWritePaths=/opt/CAFlow

StandardOutput=journal
StandardError=journal
SyslogIdentifier=caflow-api

[Install]
WantedBy=multi-user.target
