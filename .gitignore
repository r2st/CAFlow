# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Test / tooling caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Node / frontend ---
node_modules/
dist/
.vite/
# `vitest run --coverage` writes its HTML report here.
coverage/

# --- Secrets & local config ---
# .env holds a real SECRET_KEY and API keys — commit .env.example instead.
.env
.env.local
*.local
# keys/ holds the deploy private key — never commit it.
keys/

# --- Local databases ---
*.db
*.sqlite3

# --- Uploaded client documents (STORAGE_DIR) ---
backend/var/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp
